{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/common/**/*", "src/mechanics/**/*", "src/games/**/*", "src/network/**/*", "src/server/**/*"],
  "exclude": ["src/sandbox/**/*", "tests/**/*"]
}

